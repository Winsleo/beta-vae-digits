"""Train, evaluate, and plot the P1 β-VAE on binarized sklearn digits.

CPU only. Validation monitors convergence and does not select checkpoints.
The delivered model for every β is the epoch-100 checkpoint.
"""

from __future__ import annotations

import argparse
import json
import os
import random
import subprocess
import sys
import time
from pathlib import Path

# Hide GPUs before torch initializes. Empty means no device, not a real card.
os.environ["CUDA_VISIBLE_DEVICES"] = ""
_THREADS = int(os.environ.get("P1_NUM_THREADS", "4"))
os.environ["OMP_NUM_THREADS"] = str(_THREADS)
os.environ["MKL_NUM_THREADS"] = str(_THREADS)
os.environ["OPENBLAS_NUM_THREADS"] = str(_THREADS)
os.environ["NUMEXPR_NUM_THREADS"] = str(_THREADS)

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import torch

torch.set_num_threads(_THREADS)
try:
    torch.set_num_interop_threads(1)
except RuntimeError:
    pass

from data_prep import prepare_data
from vae_model import VAE

ROOT = Path(__file__).resolve().parent
DATA_DIR = ROOT / "data"
MODEL_DIR = ROOT / "models"
FIG_DIR = ROOT / "results" / "figs"
SUPP_FIG_DIR = FIG_DIR / "supplementary"
METRIC_DIR = ROOT / "results" / "metrics"
LATENT_DIR = ROOT / "results" / "latent_codes"

BETAS = (0.0, 0.1, 1.0, 4.0)
EPOCHS = 100
BATCH_SIZE = 128
LR = 1e-3
TRAIN_SEED = 42
EVAL_SEED = 12345
MC_SAMPLES = 20
PRIOR_COUNT = 16
INTERP_STEPS = 11
TIMING_THREADS = (1, 2, 4, 8)


def beta_tag(beta: float) -> str:
    mapping = {0.0: "beta0", 0.1: "beta0p1", 1.0: "beta1", 4.0: "beta4"}
    if beta not in mapping:
        raise ValueError(f"unexpected beta {beta}")
    return mapping[beta]


def beta_label(beta: float) -> str:
    if beta == 0.0:
        return "0"
    if beta == 0.1:
        return "0.1"
    return str(int(beta))


def ensure_dirs() -> None:
    for path in (DATA_DIR, MODEL_DIR, FIG_DIR, SUPP_FIG_DIR, METRIC_DIR, LATENT_DIR):
        path.mkdir(parents=True, exist_ok=True)


def assert_cpu() -> None:
    if torch.cuda.is_available():
        raise RuntimeError("CUDA is visible; this task is CPU-only and will not run.")
    if _THREADS < 1:
        raise RuntimeError(f"invalid thread count {_THREADS}")


def set_seed(seed: int) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)


def load_arrays():
    x = np.load(DATA_DIR / "x_all.npy")
    y = np.load(DATA_DIR / "y_all.npy")
    train_idx = np.load(DATA_DIR / "train_idx.npy")
    val_idx = np.load(DATA_DIR / "val_idx.npy")
    test_idx = np.load(DATA_DIR / "test_idx.npy")
    return x, y, train_idx, val_idx, test_idx


def class_counts(indices: np.ndarray, y: np.ndarray) -> dict:
    return {str(c): int(np.sum(y[indices] == c)) for c in range(10)}


def first_test_index_per_class(test_idx: np.ndarray, y: np.ndarray) -> list[int]:
    chosen = []
    for digit in range(10):
        hits = sorted(int(i) for i in test_idx.tolist() if int(y[i]) == digit)
        if not hits:
            raise RuntimeError(f"digit {digit} is missing from the test split")
        chosen.append(hits[0])
    return chosen


def train_one_epoch(model, optimizer, x_train: np.ndarray, beta: float, epoch: int) -> dict:
    model.train()
    n = x_train.shape[0]
    generator = torch.Generator()
    generator.manual_seed(TRAIN_SEED + epoch)
    perm = torch.randperm(n, generator=generator).numpy()

    bce_sum = 0.0
    kl_sum = 0.0
    weighted_loss_sum = 0.0
    seen = 0
    for start in range(0, n, BATCH_SIZE):
        batch_np = np.ascontiguousarray(x_train[perm[start : start + BATCH_SIZE]])
        xb = torch.from_numpy(batch_np)
        optimizer.zero_grad(set_to_none=True)
        logits, _mu, _logvar, _z = model(xb)
        bce = model.compute_bce_sum(logits, xb)
        kl = model.compute_kl(_mu, _logvar)
        # Batch mean of per-image (pixel-sum BCE + β * latent-sum KL). β=0 still samples.
        loss = torch.mean(bce + beta * kl)
        loss.backward()
        optimizer.step()
        bsz = int(xb.shape[0])
        bce_sum += float(bce.detach().sum())
        kl_sum += float(kl.detach().sum())
        weighted_loss_sum += float(loss.detach()) * bsz
        seen += bsz

    return {
        "train_bce": bce_sum / seen,
        "train_kl": kl_sum / seen,
        "train_beta_weighted_loss": weighted_loss_sum / seen,
    }


@torch.no_grad()
def monitor_val(model, x_val: np.ndarray) -> dict:
    """Single posterior sample on val. Monitoring only; not the test metric and not used to pick a model."""
    model.eval()
    xb = torch.from_numpy(np.ascontiguousarray(x_val))
    mu, logvar = model.encode(xb)
    kl = model.compute_kl(mu, logvar)
    generator = torch.Generator()
    generator.manual_seed(EVAL_SEED)
    eps = torch.randn(mu.shape, generator=generator)
    z = mu + torch.exp(0.5 * logvar) * eps
    logits = model.decode(z)
    bce = model.compute_bce_sum(logits, xb)
    return {
        "val_monitor_bce_one_sample": float(bce.mean()),
        "val_monitor_kl": float(kl.mean()),
    }


def train_beta(beta: float) -> None:
    assert_cpu()
    ensure_dirs()
    x, _y, train_idx, val_idx, _test_idx = load_arrays()
    x_train = x[train_idx]
    x_val = x[val_idx]
    set_seed(TRAIN_SEED)
    model = VAE(latent_dim=2)
    if next(model.parameters()).device.type != "cpu":
        raise RuntimeError("model is not on CPU")
    optimizer = torch.optim.Adam(model.parameters(), lr=LR)
    history = []
    epoch_seconds = []
    t_train = 0.0
    for epoch in range(1, EPOCHS + 1):
        t0 = time.perf_counter()
        row = train_one_epoch(model, optimizer, x_train, beta, epoch)
        dt = time.perf_counter() - t0
        t_train += dt
        epoch_seconds.append(dt)
        row.update(monitor_val(model, x_val))
        row["epoch"] = epoch
        row["train_seconds"] = dt
        history.append(row)
        if epoch == 1 or epoch % 10 == 0 or epoch == EPOCHS:
            print(
                f"beta={beta_label(beta)} epoch={epoch}/{EPOCHS} "
                f"train_bce={row['train_bce']:.4f} train_kl={row['train_kl']:.4f} "
                f"val_bce={row['val_monitor_bce_one_sample']:.4f} "
                f"val_kl={row['val_monitor_kl']:.4f} epoch_s={dt:.4f}",
                flush=True,
            )

    tag = beta_tag(beta)
    torch.save(model.state_dict(), MODEL_DIR / f"{tag}.pt")
    # Diagnostic only: the minimum val monitor is recorded and then ignored.
    monitor_scores = [
        h["val_monitor_bce_one_sample"] + h["val_monitor_kl"] for h in history
    ]
    payload = {
        "beta": beta,
        "epochs": EPOCHS,
        "delivered_epoch": EPOCHS,
        "selection_rule": "last_epoch_only",
        "val_used_for_selection": False,
        "test_used_for_selection": False,
        "ignored_min_val_monitor_epoch": int(np.argmin(monitor_scores)) + 1,
        "threads": _THREADS,
        "torch_num_threads": int(torch.get_num_threads()),
        "train_seed": TRAIN_SEED,
        "batch_size": BATCH_SIZE,
        "lr": LR,
        "optimizer": "Adam",
        "epoch_seconds": epoch_seconds,
        "mean_epoch_seconds": float(np.mean(epoch_seconds)),
        "total_train_seconds": t_train,
        "history": history,
    }
    (METRIC_DIR / f"history_{tag}.json").write_text(json.dumps(payload, indent=2))
    print(
        f"saved {tag} mean_epoch_s={payload['mean_epoch_seconds']:.4f} "
        f"total_train_s={t_train:.3f}",
        flush=True,
    )


def time_one_epoch(beta: float = 1.0) -> None:
    assert_cpu()
    x, _y, train_idx, _val_idx, _test_idx = load_arrays()
    set_seed(TRAIN_SEED)
    model = VAE(latent_dim=2)
    optimizer = torch.optim.Adam(model.parameters(), lr=LR)
    t0 = time.perf_counter()
    train_one_epoch(model, optimizer, x[train_idx], beta, epoch=1)
    dt = time.perf_counter() - t0
    print(
        "TIMING_JSON "
        + json.dumps(
            {
                "threads": _THREADS,
                "torch_num_threads": int(torch.get_num_threads()),
                "epoch_seconds": dt,
                "beta": beta,
            }
        ),
        flush=True,
    )


def child_env(threads: int) -> dict:
    env = os.environ.copy()
    env["CUDA_VISIBLE_DEVICES"] = ""
    env["P1_NUM_THREADS"] = str(threads)
    env["OMP_NUM_THREADS"] = str(threads)
    env["MKL_NUM_THREADS"] = str(threads)
    env["OPENBLAS_NUM_THREADS"] = str(threads)
    env["NUMEXPR_NUM_THREADS"] = str(threads)
    return env


def run_child(args: list[str], threads: int, log_path: Path) -> subprocess.Popen:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log_f = open(log_path, "w")
    proc = subprocess.Popen(
        [sys.executable, str(ROOT / "run_p1.py"), *args, "--threads", str(threads)],
        cwd=str(ROOT),
        env=child_env(threads),
        stdout=log_f,
        stderr=subprocess.STDOUT,
    )
    proc._log_f = log_f  # closed by the caller after wait
    return proc


def wait_child(proc: subprocess.Popen, log_path: Path) -> str:
    rc = proc.wait()
    proc._log_f.close()
    text = log_path.read_text()
    if rc != 0:
        raise RuntimeError(f"command failed rc={rc} log={log_path}\n{text[-4000:]}")
    return text


def choose_threads(rows: list[dict]) -> int:
    """Prefer the smallest thread count within 15% of the fastest 1-epoch time.

    Four trainings run together, so extra threads that barely help one process
    only add oversubscription.
    """
    best = min(row["epoch_seconds"] for row in rows)
    close = [row for row in rows if row["epoch_seconds"] <= best * 1.15]
    return int(min(close, key=lambda row: row["threads"])["threads"])


def run_timing() -> dict:
    rows = []
    for threads in TIMING_THREADS:
        log_path = METRIC_DIR / f"timing_probe_threads{threads}.log"
        proc = run_child(["time-one"], threads, log_path)
        text = wait_child(proc, log_path)
        line = next(line for line in text.splitlines() if line.startswith("TIMING_JSON "))
        rows.append(json.loads(line.split(" ", 1)[1]))
        print(
            f"probe threads={threads} epoch_s={rows[-1]['epoch_seconds']:.4f}",
            flush=True,
        )
    chosen = choose_threads(rows)
    best = min(rows, key=lambda row: row["epoch_seconds"])
    estimate = {
        "cpu_count": os.cpu_count(),
        "probes": rows,
        "selection_rule": (
            "smallest thread count whose 1-epoch time is within 15% of the fastest probe; "
            "probes are sequential so they do not contend with each other"
        ),
        "chosen_threads_per_process": chosen,
        "parallel_processes": len(BETAS),
        "approx_total_threads_when_parallel": chosen * len(BETAS),
        "fastest_probe_epoch_seconds": best["epoch_seconds"],
        "estimated_100epoch_seconds_one_beta": best["epoch_seconds"] * EPOCHS,
        "estimated_100epoch_wall_seconds_if_parallel": best["epoch_seconds"] * EPOCHS,
    }
    return estimate


def load_model(beta: float) -> VAE:
    model = VAE(latent_dim=2)
    state = torch.load(MODEL_DIR / f"{beta_tag(beta)}.pt", map_location="cpu", weights_only=True)
    model.load_state_dict(state)
    model.eval()
    return model


@torch.no_grad()
def evaluate_split(model: VAE, x_split: np.ndarray) -> dict:
    """20-sample posterior MC reconstruction NLL and closed-form KL, averaged over images."""
    xb = torch.from_numpy(np.ascontiguousarray(x_split.astype(np.float32)))
    mu, logvar = model.encode(xb)
    kl_dim = 0.5 * (mu.square() + torch.exp(logvar) - 1.0 - logvar)
    kl = kl_dim.sum(dim=1)
    generator = torch.Generator()
    generator.manual_seed(EVAL_SEED)
    acc = torch.zeros(xb.shape[0])
    for _ in range(MC_SAMPLES):
        eps = torch.randn(mu.shape, generator=generator)
        z = mu + torch.exp(0.5 * logvar) * eps
        logits = model.decode(z)
        acc = acc + model.compute_bce_sum(logits, xb)
    recon = acc / MC_SAMPLES
    recon_mean = float(recon.mean())
    kl_mean = float(kl.mean())
    return {
        "recon_nll": recon_mean,
        "kl": kl_mean,
        "neg_elbo": recon_mean + kl_mean,
        "kl_dim0": float(kl_dim[:, 0].mean()),
        "kl_dim1": float(kl_dim[:, 1].mean()),
        "n_images": int(xb.shape[0]),
        "mc_samples": MC_SAMPLES,
        "eval_seed": EVAL_SEED,
        "mu": mu,
        "logvar": logvar,
    }


@torch.no_grad()
def sensitivity(model: VAE, mu: torch.Tensor) -> dict:
    """Enhancement, not a required deliverable: does changing z change the decoded probabilities?"""
    base = torch.sigmoid(model.decode(mu))
    shifted = mu.clone()
    shifted[:, 0] = shifted[:, 0] + 2.0
    alt = torch.sigmoid(model.decode(shifted))
    zero = torch.sigmoid(model.decode(torch.zeros_like(mu)))
    return {
        "mean_abs_prob_diff_mu_vs_mu_plus_2_on_dim0": float((base - alt).abs().mean()),
        "mean_abs_prob_diff_mu_vs_zero": float((base - zero).abs().mean()),
    }


def make_prior_z() -> torch.Tensor:
    generator = torch.Generator()
    generator.manual_seed(EVAL_SEED)
    return torch.randn(PRIOR_COUNT, 2, generator=generator)


def style_image_axis(ax, image: np.ndarray, title: str | None = None) -> None:
    ax.imshow(image.reshape(8, 8), cmap="gray", vmin=0.0, vmax=1.0, interpolation="nearest")
    ax.set_xticks([])
    ax.set_yticks([])
    if title:
        ax.set_title(title, fontsize=8)


def plot_recon(path: Path, beta: float, originals: np.ndarray, probs: np.ndarray, digits: list[int]) -> None:
    n = originals.shape[0]
    fig, axes = plt.subplots(2, n, figsize=(1.15 * n, 3.5))
    for i in range(n):
        style_image_axis(axes[0, i], originals[i], title=str(digits[i]))
        style_image_axis(axes[1, i], probs[i])
    axes[0, 0].set_ylabel("original binary", fontsize=8)
    axes[1, 0].set_ylabel("sigmoid prob", fontsize=8)
    fig.suptitle(
        f"β={beta_label(beta)}  same test originals vs reconstruction\n"
        "Decoded from encoder mean μ (not a posterior sample). "
        "Pixels are sigmoid probabilities, not Bernoulli samples.",
        fontsize=9,
    )
    fig.tight_layout()
    fig.savefig(path, dpi=140)
    plt.close(fig)


def plot_prior(path: Path, beta: float, probs: np.ndarray) -> None:
    side = int(np.sqrt(probs.shape[0]))
    fig, axes = plt.subplots(side, side, figsize=(6.2, 6.8))
    for i, ax in enumerate(axes.ravel()):
        style_image_axis(ax, probs[i])
    fig.suptitle(
        f"β={beta_label(beta)}  prior samples, shared z ~ N(0, I)\n"
        "Decoded from those z. Pixels are sigmoid probabilities, not Bernoulli samples.",
        fontsize=9,
    )
    fig.tight_layout()
    fig.savefig(path, dpi=140)
    plt.close(fig)


def plot_scatter(
    path: Path,
    beta: float,
    mu: np.ndarray,
    labels: np.ndarray,
    xlim: tuple[float, float],
    ylim: tuple[float, float],
) -> None:
    fig, ax = plt.subplots(figsize=(6.4, 5.6))
    for digit in range(10):
        mask = labels == digit
        ax.scatter(
            mu[mask, 0],
            mu[mask, 1],
            s=16,
            color=plt.cm.tab10(digit),
            label=str(digit),
            alpha=0.9,
            linewidths=0,
        )
    theta = np.linspace(0, 2 * np.pi, 256)
    ax.plot(np.cos(theta), np.sin(theta), color="0.6", lw=0.8, label="prior 1σ ref")
    ax.set_xlim(*xlim)
    ax.set_ylim(*ylim)
    ax.set_xlabel("μ dimension 1")
    ax.set_ylabel("μ dimension 2")
    ax.set_aspect("equal", adjustable="box")
    ax.legend(title="digit", fontsize=7, ncol=2, loc="best")
    ax.set_title(
        f"β={beta_label(beta)}  all test encoder means μ, colored by digit\n"
        "Axes shared across β. μ does not show posterior variance.\n"
        "The circle is a prior reference, not a test that q matches p.",
        fontsize=9,
    )
    fig.tight_layout()
    fig.savefig(path, dpi=140)
    plt.close(fig)


def plot_interp(
    path: Path,
    beta: float,
    probs: np.ndarray,
    original_a: np.ndarray,
    original_b: np.ndarray,
    digit_a: int,
    digit_b: int,
    index_a: int,
    index_b: int,
) -> None:
    steps = probs.shape[0]
    fig, axes = plt.subplots(2, steps, figsize=(1.15 * steps, 3.6))
    alphas = np.linspace(0.0, 1.0, steps)
    for i in range(steps):
        style_image_axis(axes[0, i], probs[i], title=f"α={alphas[i]:.1f}")
        axes[1, i].axis("off")
    style_image_axis(axes[1, 0], original_a, title=f"x_a binary d{digit_a}")
    style_image_axis(axes[1, -1], original_b, title=f"x_b binary d{digit_b}")
    fig.suptitle(
        f"β={beta_label(beta)}  linear interpolation of encoder means\n"
        f"Shared endpoints test idx {index_a} (digit {digit_a}) and {index_b} (digit {digit_b}). "
        "z(α)=(1-α)μ_a+αμ_b, then decode(z).\n"
        "Top row: sigmoid probabilities, not Bernoulli samples and not posterior samples. "
        "Bottom corners: the original binary images.",
        fontsize=9,
    )
    fig.tight_layout()
    fig.savefig(path, dpi=140)
    plt.close(fig)


def plot_monitor(histories: dict[float, dict]) -> None:
    fig, axes = plt.subplots(1, 2, figsize=(10, 4))
    for beta, payload in histories.items():
        epochs = [row["epoch"] for row in payload["history"]]
        axes[0].plot(
            epochs,
            [row["val_monitor_bce_one_sample"] for row in payload["history"]],
            label=f"β={beta_label(beta)}",
        )
        axes[1].plot(
            epochs,
            [row["val_monitor_kl"] for row in payload["history"]],
            label=f"β={beta_label(beta)}",
        )
    axes[0].set_title("val monitor: 1 posterior-sample BCE")
    axes[1].set_title("val monitor: closed-form KL")
    for ax in axes:
        ax.set_xlabel("epoch")
        ax.legend(fontsize=8)
    fig.suptitle(
        "Supplementary only. Validation is not used to select checkpoints.\n"
        "This one-sample BCE is not the 20-sample test Reconstruction NLL.",
        fontsize=9,
    )
    fig.tight_layout()
    fig.savefig(SUPP_FIG_DIR / "val_monitor_curves.png", dpi=140)
    plt.close(fig)


def pairwise_mean_abs(probs: np.ndarray) -> float:
    total = 0.0
    count = 0
    for i in range(probs.shape[0]):
        for j in range(i + 1, probs.shape[0]):
            total += float(np.mean(np.abs(probs[i] - probs[j])))
            count += 1
    return total / count


def write_metrics_table(rows: list[dict]) -> None:
    header = "beta,recon_nll,kl,neg_elbo,kl_dim0,kl_dim1,n_images,mc_samples,eval_seed\n"
    lines = [header]
    for row in rows:
        lines.append(
            f"{beta_label(row['beta'])},{row['recon_nll']:.8f},{row['kl']:.8f},"
            f"{row['neg_elbo']:.8f},{row['kl_dim0']:.8f},{row['kl_dim1']:.8f},"
            f"{row['n_images']},{row['mc_samples']},{row['eval_seed']}\n"
        )
    (METRIC_DIR / "test_metrics.csv").write_text("".join(lines))

    md = [
        "# Test metrics",
        "",
        "Per-image means on the shared test split. Reconstruction NLL is a 20-sample posterior Monte Carlo estimate.",
        "KL is the closed form, averaged over test images. Standard negative ELBO is Recon NLL + KL.",
        "KL is not marked “smaller is better”. The β-weighted training loss is not used to rank models.",
        "Checkpoint rule: epoch 100. Validation was monitored and not used for selection. The test set was not used for selection.",
        "",
        "| β | Recon NLL | KL | 标准负 ELBO |",
        "|---|---:|---:|---:|",
    ]
    for row in rows:
        md.append(
            f"| {beta_label(row['beta'])} | {row['recon_nll']:.4f} | {row['kl']:.4f} | {row['neg_elbo']:.4f} |"
        )
    md.append("")
    md.append("Per-dimension KL (enhancement, mean over test images):")
    md.append("")
    md.append("| β | KL dim 1 | KL dim 2 |")
    md.append("|---|---:|---:|")
    for row in rows:
        md.append(f"| {beta_label(row['beta'])} | {row['kl_dim0']:.4f} | {row['kl_dim1']:.4f} |")
    md.append("")
    (METRIC_DIR / "test_metrics.md").write_text("\n".join(md))


def evaluate_and_plot(timing: dict, train_wall_s: float) -> None:
    assert_cpu()
    # Figures decode stored weights. Gradients are not part of evaluation.
    torch.set_grad_enabled(False)
    x, y, train_idx, val_idx, test_idx = load_arrays()
    recon_ids = first_test_index_per_class(test_idx, y)
    index_a, index_b = recon_ids[0], recon_ids[1]
    prior_z = make_prior_z()
    np.save(LATENT_DIR / "shared_prior_z.npy", prior_z.numpy())
    viz = {
        "recon_test_indices_one_per_digit": recon_ids,
        "interp_endpoint_indices": [index_a, index_b],
        "interp_endpoint_digits": [int(y[index_a]), int(y[index_b])],
        "prior_z_seed": EVAL_SEED,
        "prior_count": PRIOR_COUNT,
        "interp_steps": INTERP_STEPS,
        "recon_display": "decode(mu), sigmoid probability",
        "prior_display": "shared prior z, sigmoid probability",
        "interp_display": "decode of linearly interpolated mu, sigmoid probability",
    }
    (LATENT_DIR / "viz_indices.json").write_text(json.dumps(viz, indent=2))

    metric_rows = []
    mus = []
    histories = {}
    observations = []
    for beta in BETAS:
        model = load_model(beta)
        test_out = evaluate_split(model, x[test_idx])
        val_out = evaluate_split(model, x[val_idx])
        mu = test_out.pop("mu")
        logvar = test_out.pop("logvar")
        mus.append(mu.numpy())
        sens = sensitivity(model, mu)
        prior_probs = torch.sigmoid(model.decode(prior_z)).numpy()
        # Decode the shared test originals from their own μ, not from a posterior sample.
        mu_recon, _logvar_recon = model.encode(
            torch.from_numpy(np.ascontiguousarray(x[recon_ids]))
        )
        recon_probs = torch.sigmoid(model.decode(mu_recon)).numpy()
        mu_a = model.encode(torch.from_numpy(np.ascontiguousarray(x[[index_a]])))[0][0]
        mu_b = model.encode(torch.from_numpy(np.ascontiguousarray(x[[index_b]])))[0][0]
        alphas = torch.linspace(0.0, 1.0, INTERP_STEPS).unsqueeze(1)
        z_line = (1.0 - alphas) * mu_a + alphas * mu_b
        interp_probs = torch.sigmoid(model.decode(z_line)).numpy()

        tag = beta_tag(beta)
        np.savez(
            LATENT_DIR / f"{tag}_test_latent.npz",
            mu=mu.numpy(),
            logvar=logvar.numpy(),
            test_idx=test_idx,
            y=y[test_idx],
        )
        plot_recon(
            FIG_DIR / f"{tag}_recon.png",
            beta,
            x[recon_ids],
            recon_probs,
            [int(y[i]) for i in recon_ids],
        )
        plot_prior(FIG_DIR / f"{tag}_prior.png", beta, prior_probs)
        # scatter limits filled after the loop; store data via mus
        plot_interp(
            FIG_DIR / f"{tag}_interp.png",
            beta,
            interp_probs,
            x[index_a],
            x[index_b],
            int(y[index_a]),
            int(y[index_b]),
            index_a,
            index_b,
        )
        history = json.loads((METRIC_DIR / f"history_{tag}.json").read_text())
        histories[beta] = history
        if abs((test_out["recon_nll"] + test_out["kl"]) - test_out["neg_elbo"]) > 1e-5:
            raise RuntimeError("neg ELBO is not recon + KL")
        row = {"beta": beta, **test_out}
        metric_rows.append(row)
        observations.append(
            {
                "beta": beta,
                "test": test_out,
                "val_20mc_not_used_for_selection": {
                    "recon_nll": val_out["recon_nll"],
                    "kl": val_out["kl"],
                    "neg_elbo": val_out["neg_elbo"],
                },
                "sensitivity": sens,
                "prior_mean_pixel_std": float(prior_probs.std(axis=0).mean()),
                "prior_pairwise_mean_abs": pairwise_mean_abs(prior_probs),
                "mu_mean": mu.mean(dim=0).tolist(),
                "mu_std": mu.std(dim=0, unbiased=False).tolist(),
                "mean_posterior_std": torch.exp(0.5 * logvar).mean(dim=0).tolist(),
                "mean_epoch_seconds": history["mean_epoch_seconds"],
                "total_train_seconds": history["total_train_seconds"],
                "final_train_bce": history["history"][-1]["train_bce"],
                "final_train_kl": history["history"][-1]["train_kl"],
                "final_val_monitor_bce_one_sample": history["history"][-1]["val_monitor_bce_one_sample"],
                "final_val_monitor_kl": history["history"][-1]["val_monitor_kl"],
            }
        )

    stacked = np.concatenate(mus, axis=0)
    pad = 0.5
    xlim = (float(stacked[:, 0].min() - pad), float(stacked[:, 0].max() + pad))
    ylim = (float(stacked[:, 1].min() - pad), float(stacked[:, 1].max() + pad))
    # Rebuild scatters with shared limits. Other figures are already final.
    for beta, mu_np in zip(BETAS, mus):
        plot_scatter(
            FIG_DIR / f"{beta_tag(beta)}_mu_scatter.png",
            beta,
            mu_np,
            y[test_idx],
            xlim,
            ylim,
        )

    write_metrics_table(metric_rows)
    plot_monitor(histories)
    (METRIC_DIR / "observations.json").write_text(json.dumps(observations, indent=2))

    import matplotlib as mpl
    import scipy
    import sklearn

    config = {
        "task": "P1 beta-VAE binarized digits",
        "device": "cpu",
        "cuda_visible_devices": "",
        "betas": list(BETAS),
        "beta0_still_samples": True,
        "epochs": EPOCHS,
        "delivered_checkpoint": "epoch_100",
        "val_used_for_selection": False,
        "test_used_for_selection": False,
        "optimizer": "Adam",
        "lr": LR,
        "batch_size": BATCH_SIZE,
        "adam_defaults": {"betas": [0.9, 0.999], "eps": 1e-8, "weight_decay": 0.0},
        "loss": "batch mean of (sum of 64 pixel BCE-with-logits + beta * sum of 2-d KL)",
        "train_seed": TRAIN_SEED,
        "data_split_seed": 42,
        "data_split": "stratified two-stage 60/20/20, both random_state=42, threshold >= 0.5 after /16",
        "eval_seed": EVAL_SEED,
        "mc_samples": MC_SAMPLES,
        "labels_used_in_training": False,
        "n_train": int(len(train_idx)),
        "n_val": int(len(val_idx)),
        "n_test": int(len(test_idx)),
        "class_counts": {
            "train": class_counts(train_idx, y),
            "val": class_counts(val_idx, y),
            "test": class_counts(test_idx, y),
        },
        "viz": viz,
        "scatter_xlim": xlim,
        "scatter_ylim": ylim,
        "timing": timing,
        "parallel_train_wall_seconds": train_wall_s,
        "packages": {
            "python": sys.version,
            "executable": sys.executable,
            "torch": torch.__version__,
            "torch_file": torch.__file__,
            "numpy": np.__version__,
            "numpy_file": np.__file__,
            "matplotlib": mpl.__version__,
            "matplotlib_file": mpl.__file__,
            "scipy": scipy.__version__,
            "scipy_file": scipy.__file__,
            "sklearn": sklearn.__version__,
            "sklearn_file": sklearn.__file__,
        },
        "reuse": {
            "interpreter_note": "CPython 3.11.9 already used by .venv-state-trajectory",
            "reused_site_packages": "/vepfs/wangshilong/envs/worldmodel-wan/lib/python3.11/site-packages",
            "reused_packages": ["torch", "numpy", "matplotlib", "scipy"],
            "installed_into_project_venv": [
                "scikit-learn",
                "joblib",
                "threadpoolctl",
                "cloudpickle",
                "narwhals",
            ],
            "torch_reinstalled": False,
        },
    }
    (ROOT / "results" / "config.json").write_text(json.dumps(config, indent=2))
    timing["parallel_train_wall_seconds"] = train_wall_s
    timing["per_beta_train_seconds"] = {
        beta_tag(beta): histories[beta]["total_train_seconds"] for beta in BETAS
    }
    timing["per_beta_mean_epoch_seconds"] = {
        beta_tag(beta): histories[beta]["mean_epoch_seconds"] for beta in BETAS
    }
    (METRIC_DIR / "timing.json").write_text(json.dumps(timing, indent=2))
    print("wrote metrics, figures, config", flush=True)


def run_correctness() -> None:
    env = child_env(_THREADS)
    proc = subprocess.run(
        [sys.executable, str(ROOT / "vae_model.py")],
        cwd=str(ROOT),
        env=env,
        check=True,
        capture_output=True,
        text=True,
    )
    text = proc.stdout
    if proc.stderr:
        text += "\n" + proc.stderr
    (METRIC_DIR / "correctness_tests.txt").write_text(text)
    print(text, end="" if text.endswith("\n") else "\n")


def cmd_all() -> None:
    assert_cpu()
    ensure_dirs()
    run_correctness()
    prepare_data(str(DATA_DIR))
    timing = run_timing()
    threads = timing["chosen_threads_per_process"]
    print(f"chosen threads per process={threads}", flush=True)
    (METRIC_DIR / "timing_estimate.json").write_text(json.dumps(timing, indent=2))
    procs = []
    t0 = time.perf_counter()
    for beta in BETAS:
        tag = beta_tag(beta)
        proc = run_child(
            ["train-one", "--beta", beta_label(beta)],
            threads,
            METRIC_DIR / f"train_{tag}.log",
        )
        procs.append(proc)
    for beta, proc in zip(BETAS, procs):
        wait_child(proc, METRIC_DIR / f"train_{beta_tag(beta)}.log")
    train_wall_s = time.perf_counter() - t0
    print(f"parallel train wall_s={train_wall_s:.3f}", flush=True)
    evaluate_and_plot(timing, train_wall_s)


def parse_args():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--threads", type=int, default=_THREADS)
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("all", parents=[common])
    sub.add_parser("time-one", parents=[common])
    train = sub.add_parser("train-one", parents=[common])
    train.add_argument("--beta", required=True)
    eval_only = sub.add_parser("eval-only", parents=[common])
    eval_only.add_argument("--wall", type=float, required=True)
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if args.threads != _THREADS:
        raise RuntimeError(
            f"--threads {args.threads} does not match P1_NUM_THREADS={_THREADS}. "
            "Set the environment before the process starts."
        )
    if args.cmd == "all":
        cmd_all()
    elif args.cmd == "time-one":
        time_one_epoch()
    elif args.cmd == "train-one":
        beta = float(args.beta)
        if beta not in BETAS:
            raise RuntimeError(f"beta {beta} is not one of {BETAS}")
        train_beta(beta)
    elif args.cmd == "eval-only":
        assert_cpu()
        ensure_dirs()
        timing = json.loads((METRIC_DIR / "timing_estimate.json").read_text())
        evaluate_and_plot(timing, args.wall)
    else:
        raise RuntimeError(args.cmd)


if __name__ == "__main__":
    main()
